# Sample Emails Only Configuration
# This configuration will use only generated sample emails for testing

# Database Configuration (you'll need PostgreSQL running)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/email_processor_db

# Scheduler Configuration
SCHEDULER_INTERVAL_MINUTES=30
SAMPLE_EMAILS_COUNT=15
USE_SAMPLE_EMAILS_ONLY=True

# ML Model Configuration
MODEL_PATH=./models
HUGGINGFACE_MODEL_NAME=sentence-transformers/all-MiniLM-L6-v2

# API Configuration
API_HOST=0.0.0.0
API_PORT=8000
DEBUG=True

# Logging
LOG_LEVEL=INFO
LOG_FILE=./logs/app.log

# Note: No email service credentials needed when using sample emails only
# OUTLOOK_EMAIL=
# OUTLOOK_PASSWORD=
# GMAIL_CLIENT_ID=
# GMAIL_CLIENT_SECRET=
